# Alpine Test Environment for curllm
FROM alpine:3.19@sha256:6bd2275da52e3a69ffbe28739e65cdb0ac1167f9a8d9d16e129ab83f0a189c19

ENV PYTHONUNBUFFERED=1

RUN apk add --no-cache \
    python3 \
    py3-pip \
    curl \
    wget \
    git \
    bash \
    gcc \
    musl-dev \
    python3-dev \
    libffi-dev \
    openssl-dev \
    build-base

RUN adduser -D -s /bin/bash testuser
WORKDIR /test
RUN chown testuser:testuser /test
USER testuser

COPY --chown=testuser:testuser test_pypi_install.sh /test/
RUN chmod +x /test/test_pypi_install.sh

CMD ["/test/test_pypi_install.sh"]
